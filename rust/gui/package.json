{
  "name": "ncx-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run protocol:check && vite",
    "protocol:generate": "node ../../scripts/check-protocol-version.mjs --write",
    "protocol:check": "node ../../scripts/check-protocol-version.mjs --check",
    "test:protocol": "node --test ../../scripts/check-protocol-version.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run protocol:check && npm run typecheck && vite build",
    "test:e2e:question": "node e2e/question.mjs",
    "test:e2e:protocol": "node e2e/protocol.mjs",
    "test:e2e:provider-switch": "node e2e/provider-switch.mjs",
    "test:e2e:slash": "node e2e/slash.mjs",
    "test:e2e:orchestrator": "node e2e/orchestrator.mjs",
    "test:e2e:goal-worker": "node e2e/goal-worker.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:installer": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri:installer:forge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-forge-runtime.ps1 && tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.forge.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "~2.3.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "2.8.0",
    "playwright-core": "1.55.0",
    "svelte": "^5",
    "typescript": "^5",
    "vite": "^6"
  }
}
